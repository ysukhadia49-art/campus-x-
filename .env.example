# Campus X AI Environment Configuration Template
# Copy this file to .env and provide your deployment secrets

# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication & Cryptography
# Generate a strong 64-character random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-32-byte-hex-secret-must-be-provided-in-production

# CORS Allowed Origins (comma-separated list of trusted origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3099,http://127.0.0.1:3099,capacitor://localhost,https://localhost

# Supabase Database Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-public-key
